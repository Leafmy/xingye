# ============================================================
# 星野 Xingye · 运行时目录版本控制规则
# 本目录是「绿色运行版」App 文件夹：只跟踪体积小、需要审阅的
# 脚本与配置；运行时依赖、二进制、数据与日志一律不入库。
# ============================================================

# ---------- 运行时依赖与二进制（体积大，不入库） ----------
/node/
/app/bot-backend/node_modules/
/app/bot-backend/BBDown/
/SnowLuma/native/
/xingye.exe
**/*.exe

# ---------- 构建产物（面板/后端编译结果） ----------
/app/bot-backend/dist/
/app/panel-frontend/dist/
**/dist/

# ---------- 运行期数据与日志 ----------
/app/data/
/app/bot-backend/logs/
/SnowLuma/logs/
/SnowLuma/config/
/temp_videos/
**/temp_videos/
*.log
.update-temp/
.update-backup/

# ---------- 本地/编辑器 ----------
.vscode/
.idea/
.trae/
*.user
*.suo
Thumbs.db
desktop.ini

# ---------- 本地存档（不随仓库分发） ----------
# 已退役的 macOS 液态玻璃主题预览图
/macOS主题预览/

# ---------- 敏感配置 ----------
.env
.env.*
!*.env.example
**/.env
**/.env.*
