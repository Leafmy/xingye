# Steam API 代理配置
# 如果你在中国大陆，需要一个能访问 Steam 的 HTTP 代理
# Flclash/Clash 默认端口: http://127.0.0.1:7890
STEAM_PROXY_URL=http://127.0.0.1:7890

# (可选) Steam API/Store 镜像地址
# STEAM_API_BASE=https://api.steampowered.com
# STEAM_STORE_BASE=https://store.steampowered.com

# External API credentials. Keep values empty in the repository.
MIMO_API_KEY=
STEAM_API_KEY=
DOUBAO_API_KEY=
DOUBAO_DRAW_MODEL=
XINGYE_GITHUB_REPO=
