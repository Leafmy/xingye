{
  "$schema": "https://raw.githubusercontent.com/nicegui/multi-user-tailwind/main/src-tauri/schemas/desktop-schema.json",
  "productName": "星野 Xingye",
  "version": "0.6.0",
  "identifier": "com.xingye.bot",
  "build": {
    "beforeDevCommand": "cd panel-frontend && npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "cd panel-frontend && npm run build",
    "frontendDist": "../panel-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "星野 Xingye",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../app/**/*",
      "../SnowLuma/**/*",
      "../BBDown/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/Leafmy/xingye/releases/latest/download/latest.json"
      ]
    }
  }
}
