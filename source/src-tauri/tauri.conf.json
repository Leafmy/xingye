{
  "$schema": "https://raw.githubusercontent.com/nicegui/multi-user-tailwind/main/src-tauri/schemas/desktop-schema.json",
  "productName": "星野 Xingye",
  "version": "0.6.0",
  "identifier": "com.xingye.bot",
  "build": {
    "beforeDevCommand": "cd ../panel-frontend && npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "cd ../panel-frontend && npm run build",
    "frontendDist": "../panel-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "星野 Xingye",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#f3f3f3",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../vendor/node/**/*",
      "../../out/app/bot-backend/dist/**/*",
      "../../out/app/bot-backend/node_modules/**/*",
      "../../out/app/bot-backend/package.json",
      "../../out/app/panel-frontend/dist/**/*",
      "../../out/app/updater/**/*",
      "../../out/app/version.json",
      "../../out/app/manifest.json",
      "../../vendor/SnowLuma/index.mjs",
      "../../vendor/SnowLuma/*.js",
      "../../vendor/SnowLuma/package.json",
      "../../vendor/SnowLuma/package-lock.json",
      "../../vendor/SnowLuma/launcher.bat",
      "../../vendor/SnowLuma/client/**/*",
      "../../vendor/SnowLuma/native/**/*",
  
      "../../vendor/BBDown/**/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MEQ0QzNEMEY0RTk0QgpSV1JMNmZUUXc5U1FCZGRLWElqUmlENUowQWZVNHdtcmswWVBhd25zaGd4TFg2UjFPcjlaUzhQWgo=",
      "endpoints": [
        "https://github.com/Leafmy/xingye/releases/latest/download/latest.json",
        "https://gitee.com/leaf-my/xingye/releases/latest/download/latest.json"
      ]
    }
  }
}





